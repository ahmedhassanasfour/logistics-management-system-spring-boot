# ==============================================================
# Logistics Management System - Environment Variables (.env)
# ==============================================================

# Application Profile & Server Port
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ==============================================================
# Database Configuration (PostgreSQL 17)
# ==============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=logistics_db
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION

# HikariCP Connection Pool
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000

# JPA / Hibernate Configuration
# Use 'validate' in production. Use 'update' only in local development.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# ==============================================================
# Redis Configuration (Redis 7)
# ==============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT_MS=2000ms

# ==============================================================
# JWT Security Configuration
# ==============================================================
# In production, set a cryptographically secure Base64 secret key (minimum 256 bits).
# NEVER commit production keys to version control.
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_BASE64_256_BIT_SECRET_KEY
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ==============================================================
# Mail Configuration (SMTP)
# ==============================================================
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=noreply@logistics.com
MAIL_ENABLED=true

# ==============================================================
# Geo & Routing Configuration
# ==============================================================
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=AhmedLogistics/1.0
OSRM_BASE_URL=https://router.project-osrm.org
GEO_CONNECT_TIMEOUT_MS=5000
GEO_READ_TIMEOUT_MS=5000

# ==============================================================
# Pricing Configuration
# ==============================================================
DISTANCE_RATE_PER_KM=1.50

# ==============================================================
# Async / Thread Pool Configuration
# ==============================================================
ASYNC_CORE_POOL_SIZE=5
ASYNC_MAX_POOL_SIZE=20
ASYNC_QUEUE_CAPACITY=100
ASYNC_THREAD_NAME_PREFIX=logistics-async-
ASYNC_AWAIT_TERMINATION_SECONDS=30

# ==============================================================
# CORS Configuration (comma-separated origins)
# ==============================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000
